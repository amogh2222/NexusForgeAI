# ════════════════════════════════════════════════════
# NexusForge AI — Environment Variables
# Copy to .env and fill in your values
# ════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────
APP_ENV=development
APP_NAME=NexusForge AI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=info

# ─── Security ───────────────────────────────────────
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexusforge
POSTGRES_USER=nexusforge
POSTGRES_PASSWORD=nexusforge_secret
DATABASE_URL=postgresql+asyncpg://nexusforge:nexusforge_secret@localhost:5432/nexusforge
DATABASE_SYNC_URL=postgresql://nexusforge:nexusforge_secret@localhost:5432/nexusforge

# ─── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ─── Qdrant Vector Store ─────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=nexusforge
QDRANT_USE_GRPC=false

# ─── Neo4j Knowledge Graph ───────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexusforge_graph
NEO4J_DATABASE=neo4j

# ─── Model Router ────────────────────────────────────
MODEL_ROUTER_ENABLED=true
DEFAULT_CODER_MODEL=qwen2.5-coder:7b
DEFAULT_PLANNER_MODEL=qwen2.5-coder:7b
DEFAULT_REVIEWER_MODEL=qwen2.5-coder:7b
DEFAULT_LONG_CONTEXT_MODEL=gpt-4o-mini
LOCAL_CONTEXT_WINDOW_TOKENS=8192

# ─── Cost Tracking ───────────────────────────────────
TRACK_TOKEN_COSTS=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexusforge-ai

# ─── Ollama (Primary LLM) ───────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Alternatives: qwen2.5-coder:14b, deepseek-coder-v2:16b, codellama:13b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── OpenAI (Fallback LLM) ──────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# For OpenRouter: https://openrouter.ai/api/v1
# For Together AI: https://api.together.xyz/v1

# ─── Embedding Model ────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=512

# ─── GitHub Integration ──────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ─── File Storage ───────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=.zip,.tar.gz

# ─── Celery ─────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_MAX_RETRIES=3
CELERY_TASK_TIMEOUT=300

# ─── Sandbox Execution ──────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_DOCKER_ENABLED=false
# Set to true when running on Linux with Docker socket

# ─── Rate Limiting ──────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Frontend ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=NexusForge AI
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
